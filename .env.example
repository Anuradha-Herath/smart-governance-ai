# ==============================================================================
# Smart Governance AI - Environment Configuration Template
# Copy this file to '.env' and fill in local overrides (never commit '.env')
# ==============================================================================

# Project paths
PROJECT_ROOT="."
DATA_DIR="./data"
EXTERNAL_DATASETS_DIR="../Datasets"
MODELS_DIR="./models"
OUTPUTS_DIR="./outputs"

# Pipeline 1 - Multilingual Sentiment & Stance
DEFAULT_LANGUAGE="en"
SUPPORTED_LANGUAGES="en,si,ta"
STANCE_CONFIDENCE_THRESHOLD=0.60

# Pipeline 2 - Expert Grounded Evidence
MAX_CHUNK_TOKENS=512
VERBATIM_MATCH_MIN_LEN=20

# Pipeline 3 - Historical Case Retrieval
DEFAULT_TIME_WINDOW_YEARS=2
MACRO_INDICATORS_FILE="../Datasets/sri_lanka_macro_indicators/sri_lanka_outcome_indicators.csv"

# Optional External APIs (leave blank for local-only execution)
HUGGINGFACE_TOKEN=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
